{
  "name": "slack-copy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:next": " next dev --turbopack",
    "dev:socket": "node socket-server.ts",
    "dev": "cross-env PORT=3000 NEXT_PUBLIC_SOCKET_PORT=3001 STORAGE_TYPE=local run-p dev:next dev:socket",
    "push": "npx prisma db push --force-reset",
    "studio": "npx prisma studio",
    "build": "next build --turbopack",
    "start:next": "next start",
    "start:socket": "node socket-server.ts",
    "start": "cross-env PORT=3000 NEXT_PUBLIC_SOCKET_PORT=3001 STORAGE_TYPE=local run-p start:next start:socket",
    "test": "vitest",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
