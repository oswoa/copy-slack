    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@prisma/client": "6.19.2",
    "axios": "^1.14.0",
    "cross-env": "^10.1.0",
    "next": "^16.2.1",
    "npm-run-all": "^4.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.72.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
